# QuantRadar — see also ~/quantradar/.env.example
PUBLIC_BASE_URL=https://quantradar.one
HOST=0.0.0.0
PORT=8765
QUANTRADAR_MODE=artifact
SESSION_SECRET=replace-with-long-random-string

# Optional
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# QUANTRADAR_STRIPE_SECRET_KEY=
# STRIPE_PRICE_ID=
# STRIPE_PRICE_ID_MONTHLY=
# STRIPE_PRICE_ID_YEARLY=
# STRIPE_WEBHOOK_SECRET=
# NEVER on prod — unit-test bypass for webhook signature:
# QUANTRADAR_STRIPE_WEBHOOK_TEST=1
# CHARTS_DIR=/path/to/charts
