# MoYu — production frontend is GH Pages (chillworks.ai).
# Path B light API: Render Free moyu-fortune (no secrets required).

# Frontend build:
# VITE_STATIC_MODE=true
# VITE_MOYU_API_BASE=https://moyu-fortune.onrender.com

# Light API (Render / local):
# PORT=3000
# HOST=0.0.0.0
# MOYU_CORS_ORIGINS=https://chillworks.ai,https://www.chillworks.ai
# MOYU_DATA_DIR=./data

# OPENAI_API_KEY=   # path C only; not used by light API

# Manus publish placeholders (do not commit real values)
# VITE_ANALYTICS_ENDPOINT=
# VITE_ANALYTICS_WEBSITE_ID=
# VITE_OAUTH_PORTAL_URL=
# VITE_APP_ID=
