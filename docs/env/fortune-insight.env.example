# Fortune Insight (Render Web — SX3 tarot preview + optional full stack)
NODE_ENV=production
PORT=3000
HOST=0.0.0.0
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=mysql://user:pass@host:4000/dbname
APP_BASE_URL=https://fortunesite.one
OWNER_EMAIL=

# SX3 visitor tarot (rules fallback when no LLM key)
# TAROT_RATE_LIMIT_PER_MIN=10

# Optional Manus / OAuth (leave empty on static-lean deploys)
# VITE_APP_ID=
# VITE_OAUTH_PORTAL_URL=
# OAUTH_SERVER_URL=

# Optional Stripe / LLM (authorize before enabling)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# VITE_STRIPE_PUBLISHABLE_KEY=
# OPENAI_API_KEY=
