<view class="brand">框架自检</view>
<input placeholder="6位A股代码" value="{{symbol}}" bindinput="onSymbol" />
<button bindtap="analyze">开始自检</button>
<button bindtap="sample">免费样例</button>
<view wx:if="{{error}}" class="muted">{{error}}</view>
<block wx:if="{{result}}">
  <view class="brand">{{result.primary_score}}</view>
  <view>{{result.posture}}</view>
  <view class="muted">{{result.symbol}} {{result.name}}</view>
  <input placeholder="我的假设" bindinput="onHyp" />
  <input placeholder="失效条件" bindinput="onInv" />
  <button bindtap="saveReview">写入复盘本</button>
</block>
<view class="disclaimer">本产品为投资教育工具，不构成任何投资建议。</view>
