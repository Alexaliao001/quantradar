# Copy to .env (gitignored) or set in Render/Fly dashboard.
#   python3 scripts/bootstrap_env.py

PUBLIC_BASE_URL=https://quantradar.one
HOST=0.0.0.0
PORT=8765
QUANTRADAR_MODE=artifact

# Required for signed sessions in production
SESSION_SECRET=replace-with-long-random-string

# Google OAuth (optional if magic link is enough)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Magic link email (optional — without SMTP, links go to console + data/last_magic_link.txt)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1
# MAGIC_LINK_ALLOWLIST=you@example.com
# MAGIC_LINK_DISABLED=0

# Stripe (optional) — can import from ~/charts/.env.site
QUANTRADAR_STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=

# Charts engine (for mode=live on a host that mounts charts)
# CHARTS_DIR=/path/to/charts

# Local only
# QUANTRADAR_DEV_LOGIN=1
